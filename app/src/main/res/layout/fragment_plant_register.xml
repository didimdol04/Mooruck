<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ui.plant.PlantRegisterFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="100dp">

            <!-- 상단 영역: 뒤로가기 버튼과 화면 제목 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 이전 화면으로 돌아간다. -->
                <ImageButton
                    android:id="@+id/buttonBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="뒤로가기"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back" />

                <!-- 화면 제목 -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="식물 등록"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 프로필 사진 영역 -->
            <FrameLayout
                android:id="@+id/profileImageContainer"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp">

                <ImageView
                    android:id="@+id/ivPlantProfile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_card"
                    android:contentDescription="식물 프로필 사진"
                    android:padding="4dp"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery" />

                <ImageButton
                    android:id="@+id/btnSelectImage"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="end|bottom"
                    android:backgroundTint="#2E6B4A"
                    android:contentDescription="프로필 사진 선택"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_camera"
                    app:tint="#FFFFFF" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="사진을 선택해 주세요"
                android:textColor="#757575"
                android:textSize="13sp" />

            <!-- 식물 검색 영역 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="식물 검색"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etSearchPlantName"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:hint="식물 이름을 입력해 주세요"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="#000000"
                    android:textColorHint="#BDBDBD"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearchPlant"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:text="검색"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#2E6B4A"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvSearchGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="식물을 검색하면 관리 정보가 자동으로 입력돼요."
                android:textColor="#757575"
                android:textSize="13sp" />

            <!-- 추후 API 검색 결과가 들어갈 영역 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPlantSearchResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                tools:itemCount="2"
                tools:listitem="@android:layout/simple_list_item_1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManualInput"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:text="직접 등록하기"
                android:textColor="#2E6B4A" />

            <!-- 기본 정보 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="식물 정보"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPlantName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:hint="식물 이름"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#BDBDBD"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etLight"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:hint="광도 예: 밝은 간접광"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#BDBDBD"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etHumidity"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:hint="습도 예: 40~60%"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#BDBDBD"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etTemperature"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:hint="온도 예: 18~25℃"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#BDBDBD"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etWateringInterval"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:hint="물주기 주기 예: 7일"
                android:inputType="number"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#BDBDBD"
                android:textSize="15sp" />

            <!-- 사용자 입력 정보 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="나의 식물 정보"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNickname"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:hint="식물 별명 (선택)"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="#000000"
                android:textColorHint="#BDBDBD"
                android:textSize="15sp" />

            <!-- 심은 날짜 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="심은 날짜"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPlantedDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="날짜를 선택해 주세요"
                android:textColor="#757575"
                android:textSize="15sp" />

            <!-- 마지막 물 준 날짜 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="마지막으로 물 준 날짜"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLastWateredDate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:text="날짜를 선택해 주세요"
                android:textColor="#757575"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/cbUnknownLastWateredDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:buttonTint="#2E6B4A"
                android:text="마지막으로 물 준 날짜를 몰라요"
                android:textColor="#757575"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvUnknownDateGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="선택하면 오늘 물을 준 것으로 기록돼요."
                android:textColor="#9E9E9E"
                android:textSize="12sp" />

            <!-- 등록 버튼 -->
            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/btnRegisterPlant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="식물 등록"
                android:textColor="#FFFFFF"
                app:backgroundTint="#2E6B4A"
                app:icon="@android:drawable/ic_input_add"
                app:iconTint="#FFFFFF" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>